name: Gerar APK Pierce Sensi
on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Baixar projeto
        uses: actions/checkout@v4

      - name: Preparar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Preparar Android
        uses: android-actions/setup-android@v3

      - name: Instalar SDK
        run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'

      - name: Extrair projeto
        run: unzip -q PierceSensi_Projeto_Android_com_build_na_nuvem.zip

      - name: Preparar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Compilar APK
        working-directory: PierceSensiAndroid
        run: gradle assembleDebug

      - name: Salvar APK
        uses: actions/upload-artifact@v4
        with:
          name: Pierce-Sensi-APK
          path: PierceSensiAndroid/app/build/outputs/apk/debug/app-debug.apk
